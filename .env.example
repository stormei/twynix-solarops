# Self-hosted BFF only. Keep .env out of source control.
NODE_ENV=development
PORT=3300
APP_ORIGIN=http://localhost:3300
SESSION_SECRET=replace-with-at-least-32-random-characters
DEMO_MODE=false
# ThingsBoard origin, including its port. Set here, then restart SolarOps.
TB_URL=
TB_PLANT_ASSET_ID=
PLANT_ID=main
PLANT_TIMEZONE=Europe/Oslo
TB_RELATION_TYPE=Contains
STALE_AFTER_MS=120000
# Set true ONLY after testing endpoints/payloads against your 4.3.8 Swagger.
TB_SCHEMA_VERIFIED=false
# Discover keys through /api/plants/main/discovery after schema verification.
# Internal names: acPower, dcPower, dcVoltage, dcCurrent, cabinetTemperature,
# lifetimeEnergy, operatingState, acCurrentL1/L2/L3, acVoltageL1N/L2N/L3N.
# Format: {"acPower":{"key":"<discovered key>","unit":"W"}, ...}
TB_TELEMETRY_MAPPING={}
# Map codes from validated KACO configuration. No numeric defaults are assumed.
# Values: mppt, standby, startup, throttled, fault, unknown.
TB_STATE_MAPPING={}

# Installed 4.4.x contract: history has its own URL suffix.
TB_VERSION=4.4.0
TB_HISTORY_PATH=/history
# Alternative to an asset: discover only this user's permitted device name prefix.
# Example prefix: Solar - (include the trailing space).
TB_DEVICE_PREFIX=
PLANT_NAME=Solar plant
TB_SIMULATED_SOURCE=false
TB_DEVICE_MODEL=
# Optional site-controller mapping: acPower, dcPower, energy, gridExport,
# irradiance (W/m²), airTemperature (°C), cloudCover (%).
TB_SITE_MAPPING={}

# Standard installations use a tagged site asset and role/relation discovery.
# TB_DISCOVERY_MODE=standard
# TB_PLANT_ASSET_ID=<existing SolarOps site asset UUID>

# Application defaults and preferences. UI changes are saved here by the BFF.
# Language: en or nb. Theme: light or dark. No browser storage is used.
DEFAULT_LANGUAGE=en
DEFAULT_THEME=light
EDITOR_LEFT_WIDTH=210
EDITOR_RIGHT_WIDTH=310
EDITOR_SNAP_GRID=true
EDITOR_ALIGNMENT_GUIDES=true
# TB_URL is managed here, never on the login or setup screens.
# Selecting/resetting a site saves/clears its TB_PLANT_ASSET_ID and related settings.
# Passwords and session tokens never belong in this file.
