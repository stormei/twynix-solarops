{
  "name": "solarops",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run server",
    "build": "ng build",
    "test": "tsx --test tests/*.test.ts",
    "server": "tsx server/index.ts",
    "check:server": "tsc -p server/tsconfig.json --noEmit",
    "check:build": "node scripts/check-build.mjs",
    "preserver": "node scripts/ensure-env.mjs",
    "prestart": "npm run build",
    "dev:frontend": "ng serve --host 127.0.0.1 --port 4200"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "echarts": "^6.0.0",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "ws": "^8.18.3",
    "pdfkit": "^0.17.2",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "typescript": "~6.0.0",
    "tsx": "^4.20.6",
    "@types/node": "^22.18.0",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/ws": "^8.18.1",
    "@types/pdfkit": "^0.17.3"
  }
}
